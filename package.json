{
  "name": "youtube-ai-transcriber",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "api": ".venv/bin/python -m uvicorn server.app:app --reload --host 127.0.0.1 --port 8787",
    "dev:all": "concurrently -k -n web,api \"npm:dev\" \"npm:api\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "typescript": "^7.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1"
  }
}
